{
  // Project-wide config for the editor and `yarn typecheck` — covers tests too,
  // but never emits. The shippable build uses tsconfig.build.json.
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "rootDir": ".",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["bin/**/*", "src/**/*", "test/**/*", "*.config.ts"],
  "exclude": ["node_modules", "dist"]
}
