{
  "name": "premo",
  "version": "0.0.0",
  "description": "A universal remote for your projects — one set of verbs (dev, build, test, lint, deploy) that works the same way in every repo.",
  "type": "module",
  "private": true,
  "bin": {
    "premo": "./bin/premo.ts"
  },
  "scripts": {
    "premo": "tsx bin/premo.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint --fix . && prettier --write .",
    "test": "yarn test:unit",
    "test:unit": "vitest run --project=unit",
    "test:watch": "vitest --project=unit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "execa": "^9.5.1",
    "picocolors": "^1.1.1",
    "yaml": "^2.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.16.0",
    "@typescript-eslint/parser": "^8.16.0",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.6"
  }
}
