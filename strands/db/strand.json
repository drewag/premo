{
  "name": "db",
  "version": "0",
  "description": "Postgres 16 running in Docker Compose, with per-project volume.",
  "dependsOn": [],
  "softDependsOn": [],
  "ports": [{ "name": "PG_PORT", "offset": 20 }],
  "compose": {
    "profiles": ["db"],
    "services": {
      "db": {
        "image": "postgres:16",
        "container_name": "${COMPOSE_PROJECT_NAME}-db",
        "environment": {
          "POSTGRES_USER": "app",
          "POSTGRES_PASSWORD": "app",
          "POSTGRES_DB": "app"
        },
        "ports": ["${PG_PORT}:5432"],
        "volumes": ["${STRAND_DATA_DIR}/postgres:/var/lib/postgresql/data"],
        "healthcheck": {
          "test": ["CMD-SHELL", "pg_isready -U app"],
          "interval": "5s",
          "timeout": "3s",
          "retries": 10
        }
      }
    }
  },
  "claudeFragment": "claude.md",
  "shell": {
    "kind": "compose-exec",
    "service": "db",
    "command": ["psql", "-U", "app", "-d", "app"],
    "description": "psql into the project's Postgres (compose service `db`)"
  }
}
